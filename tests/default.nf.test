nextflow_pipeline {
    name "Pipeline stub tests"
    script "../main.nf"
    tag "stub"

    test("empty samplesheet completes in stub mode") {
        options "-stub"

        when {
            params {
                input = "${baseDir}/tests/data/empty_samplesheet.yml"
                outdir = "$outputDir/results"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("one sample runs read QC, the contamination screen and the assembly") {
        options "-stub"

        when {
            params {
                input = "${baseDir}/tests/data/valid_samplesheet.yml"
                outdir = "$outputDir/results"
                publish_outputs = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // 16 read QC and contamination tasks, then 4 subsets x 7 assemblers
                // (miniasm taking three processes), their normalisation, the Flye
                // fallback and its normalisation, the consensus, six finishing tasks,
                // 18 checks, the QC gate, the metrics bundle and the report.
                { assert workflow.trace.tasks().size() == 113 },
                { assert path("$outputDir/results/reads/isolate01/isolate01.read_qc.tsv").exists() },
                { assert path("$outputDir/results/contamination/isolate01/isolate01.contamination_summary.json").exists() },
                { assert path("$outputDir/results/assemblies/isolate01/final/isolate01.assembly.fasta").exists() },
                { assert path("$outputDir/results/assemblies/isolate01/isolate01.assembly_attempts.tsv").exists() },
                { assert path("$outputDir/results/assemblies/isolate01/autocycler_out").exists() },
                { assert path("$outputDir/results/assemblies/isolate01/final/isolate01.assembly_source.tsv").text.contains('autocycler') },
                { assert path("$outputDir/results/assemblies/isolate01/final/isolate01.fasta").exists() },
                { assert path("$outputDir/results/assemblies/isolate01/final/isolate01.contigs.tsv").text.contains('isolate01_chromosome') },
                { assert path("$outputDir/results/checks/isolate01/isolate01.plasmid_audit.tsv").exists() },
                { assert path("$outputDir/results/checks/isolate01/isolate01.coverage_regions.tsv").exists() },
                { assert path("$outputDir/results/checks/isolate01/isolate01.variant_summary.tsv").exists() },
                { assert path("$outputDir/results/checks/isolate01/isolate01.assembler_contribution.tsv").exists() },
                { assert path("$outputDir/results/annotation/isolate01/isolate01.gff3").exists() },
                { assert path("$outputDir/results/qc/isolate01.qc.json").json.checks.read_depth != null },
                { assert path("$outputDir/results/report/run_summary/samples.tsv").text.contains('isolate01') },
                { assert path("$outputDir/results/report/run_summary/qc_gates.tsv").exists() },
                { assert path("$outputDir/results/report/isolate_assembly_report.html").exists() },
                { assert path("$outputDir/results/report/samples/isolate01.report.html").exists() },
                { assert path("$outputDir/results/pipeline_info/software_versions.tsv").text.contains('flye') }
            )
        }
    }

    test("--assemblers runs only the assemblers asked for") {
        options "-stub"

        when {
            params {
                input = "${baseDir}/tests/data/valid_samplesheet.yml"
                outdir = "$outputDir/results"
                publish_outputs = true
                assemblers = 'flye,raven'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 65 },
                { assert workflow.trace.tasks().every { !it.name.contains('CANU') } },
                { assert workflow.trace.tasks().every { !it.name.contains('HIFIASM') } },
                { assert workflow.trace.tasks().every { !it.name.contains('MINIASM') } },
                { assert workflow.trace.tasks().every { !it.name.contains('METAMDBG') } },
                // PLASSEMBLER_FULL is the plasmid audit, which runs whatever --assemblers says.
                { assert workflow.trace.tasks().every { !it.name.startsWith('ISOLATE_GENOME_ASSEMBLER:ASSEMBLY:PLASSEMBLER (') } }
            )
        }
    }

    test("autocycler_dir skips subsampling and the input assemblies") {
        options "-stub"

        when {
            params {
                input = "${baseDir}/tests/data/curated_samplesheet.yml"
                outdir = "$outputDir/results"
                publish_outputs = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Read QC and contamination, then only the Flye fallback, its
                // normalisation, the reclustering, the selection, finishing, the checks
                // and the QC gate.
                { assert workflow.trace.tasks().size() == 47 },
                { assert workflow.trace.tasks().every { !it.name.contains('SUBSAMPLE') } },
                { assert workflow.trace.tasks().every { !it.name.startsWith('ISOLATE_GENOME_ASSEMBLER:ASSEMBLY:FLYE (') } },
                { assert path("$outputDir/results/assemblies/isolate01/final/isolate01.assembly.fasta").exists() }
            )
        }
    }

    test("an unresolved consensus falls back to the full-read Flye assembly") {
        options "-stub"

        when {
            params {
                input = "${baseDir}/tests/data/valid_samplesheet.yml"
                outdir = "$outputDir/results"
                publish_outputs = true
                assemblers = 'flye,raven'
                stub_fully_resolved = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/results/assemblies/isolate01/final/isolate01.assembly_source.tsv").text.contains('fallback_flye') }
            )
        }
    }

    test("a failed input assembly is recorded and does not sink the sample") {
        options "-stub"

        when {
            params {
                input = "${baseDir}/tests/data/valid_samplesheet.yml"
                outdir = "$outputDir/results"
                publish_outputs = true
                assemblers = 'flye,raven'
                stub_fail_assemblies = 'flye_01'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/results/assemblies/isolate01/final/isolate01.assembly.fasta").exists() },
                { assert path("$outputDir/results/assemblies/isolate01/isolate01.assembly_attempts.tsv").text.contains('flye\t01\tfailed') },
                { assert path("$outputDir/results/assemblies/isolate01/isolate01.assembly_attempts.tsv").text.contains('raven\t01\tok') }
            )
        }
    }

    test("missing database params fail before any task runs") {
        options "-stub"

        when {
            params {
                input = "${baseDir}/tests/data/valid_samplesheet.yml"
                outdir = "$outputDir/results"
                sylph_gtdb_db = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('--sylph_gtdb_db') } || workflow.errorReport.contains('--sylph_gtdb_db') }
            )
        }
    }

    test("--prepare_databases downloads and sketches the databases") {
        options "-stub"

        when {
            params {
                prepare_databases = true
                outdir = "$outputDir/results"
                database_dir = "$outputDir/databases"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 14 },
                { assert path("$outputDir/databases/sylph_human_db.syldb").exists() },
                { assert path("$outputDir/databases/plassembler_db").exists() },
                { assert path("$outputDir/databases/ideel_db.dmnd").exists() },
                { assert path("$outputDir/databases/busco_downloads").exists() }
            )
        }
    }
}
