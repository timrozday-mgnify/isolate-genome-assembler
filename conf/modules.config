// Publishing is opt-in. Phase-specific process entries set an explicit path and a
// saveAs closure that excludes versions.yml from scientific outputs.
process {
    publishDir = [enabled: false]

    withName: 'PREPARE_READS|HIFIADAPTERFILT|SEQKIT_STATS|NANOPLOT|READ_PROFILE|AUTOCYCLER_GENOME_SIZE|GENOMESCOPE2|READ_QC_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/reads/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'SYLPH_PROFILE|SYLPH_TAX|SYLPH_QUERY|HUMAN_FRACTION|CONTAMINATION_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/contamination/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // The databases are the whole point of `--prepare_databases`, so they publish
    // regardless of --publish_outputs. Archives are unpacked by UNTAR and the Swiss-Prot
    // FASTA is built into a DIAMOND database, so only the results are kept.
    withName: 'DOWNLOAD_DATABASE|SYLPH_SKETCH_GENOMES|PLASSEMBLER_DOWNLOAD|UNTAR|DIAMOND_MAKEDB|BAKTA_BAKTADBDOWNLOAD|BUSCO_DOWNLOAD' {
        publishDir = [
            path: { params.database_dir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.tar.gz') || filename.endsWith('.fasta.gz') ? null : filename },
        ]
    }

    withName: 'BAKTA_BAKTADBDOWNLOAD' {
        ext.args = { '--type light' }
    }

    // The input assemblies are bulky and only useful when debugging the consensus, so
    // they publish behind their own switch.
    withName: 'NORMALISE_HEADERS' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}/inputs" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs && params.publish_input_assemblies,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'AUTOCYCLER_CONSENSUS|ASSEMBLY_ATTEMPTS' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NORMALISE_HEADERS_FULL' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}/flye_full" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // The finished genome: this is what a user actually takes away.
    withName: 'CLASSIFY_REPLICONS' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}/final" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DNAAPLER|CONTIG_ENDS' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}/finishing" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'PLASSEMBLER_FULL' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}/plassembler_full" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'PLASMID_AUDIT|SKANI_DIST' {
        publishDir = [
            path: { "${params.outdir}/checks/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // The plasmids are the query and the finished assembly the reference, so skani's
    // query-side align fraction is how much of the plasmid the assembly contains.
    withName: 'SKANI_DIST' {
        ext.args = { '--min-af 50 --ci' }
        ext.prefix = { "${meta.id}.plasmid_skani" }
    }

    // Stage 6. Every check's small table lands in checks/<id>/, the Bakta annotation in
    // annotation/<id>/, and the per-sample verdict in qc/.
    withName: 'MAP_READS|MOSDEPTH|COVERAGE_REGIONS|CLIPPING_PILEUPS|INSPECTOR|VARIANT_PILEUP|VARIANT_SCAN|MERQURY_MERQURY|DIAMOND_BLASTP|GENE_CHECKS|CHECKM2_PREDICT|BUSCO_BUSCO|GTDBTK_CLASSIFYWF|SKANI_REFERENCE|BANDAGE_IMAGE|ASSEMBLER_CONTRIBUTION' {
        publishDir = [
            path: { "${params.outdir}/checks/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            // BUSCO also hands back the lineage dataset it read, which is --busco_db again.
            saveAs: { filename -> filename.equals('versions.yml') || filename.startsWith('busco_downloads') ? null : filename },
        ]
    }

    withName: 'BAKTA_BAKTA' {
        ext.args = { '--skip-plot' }
        publishDir = [
            path: { "${params.outdir}/annotation/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'QC_GATES' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // 1 kb windows are fine enough to place a collapsed IS element; the per-base track
    // would only be read back as windows anyway.
    withName: 'MOSDEPTH' {
        ext.args = { '--by 1000 --no-per-base' }
    }

    // Inspector skips contigs under 10 kb, and structural calls on contigs under 1 Mb, by
    // default: that would leave every plasmid unchecked.
    withName: 'INSPECTOR' {
        ext.args = { '--min_contig_length 1000 --min_contig_length_assemblyerror 1000' }
    }

    // HiFi plasmids can be hundreds of times chromosome depth; mpileup's default cap of
    // 250 reads would hide their minority alleles.
    withName: 'VARIANT_PILEUP' {
        ext.args = { '--max-depth 100000' }
    }

    // Flye names its files generically, so the unmapped-read assembly gets its own folder.
    withName: 'FLYE_UNMAPPED' {
        publishDir = [
            path: { "${params.outdir}/checks/${meta.id}/unmapped_flye" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/').last() },
        ]
    }

    // The best hit per protein is all the IDEEL test compares against.
    withName: 'DIAMOND_BLASTP' {
        ext.args = { '--max-target-seqs 1' }
        ext.prefix = { "${meta.id}.ideel_hits" }
    }

    // CheckM2 and GTDB-Tk look for .fna by default; the final assembly is .fasta.
    withName: 'CHECKM2_PREDICT' {
        ext.args = { '-x fasta' }
    }

    withName: 'GTDBTK_CLASSIFYWF' {
        ext.args = { '--extension fasta --skip_ani_screen' }
    }

    withName: 'SKANI_REFERENCE' {
        ext.args = { '--ci' }
        ext.prefix = { "${meta.id}.reference_skani" }
    }

    withName: 'SELECT_ASSEMBLY' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}/final" },
            mode: params.publish_dir_mode,
            enabled: params.publish_outputs,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'SEQKIT_STATS' {
        ext.args = { '--all' }
    }

    // map-hifi is the preset for HiFi reads; -c/--cs are not needed for a read-name count.
    withName: 'MINIMAP2_ALIGN' {
        ext.args = { '-x map-hifi --secondary=no' }
        ext.prefix = { "${meta.id}.human" }
    }

    // Sequence abundance below 0.01% is noise at isolate depth; -u reports the unknown
    // fraction the report shows alongside the placed species.
    withName: 'SYLPH_PROFILE' {
        ext.args = { '--minimum-ani 95 -u' }
        ext.prefix = { "${meta.id}.sylph_profile" }
    }

    withName: 'SYLPH_QUERY' {
        ext.args = { '' }
        ext.prefix = { "${meta.id}.human_query" }
    }

    withName: 'NANOPLOT' {
        ext.args = { '--tsv_stats' }
    }
}
