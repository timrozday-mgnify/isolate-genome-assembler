process {
    errorStrategy = { task.exitStatus in [104, 125, 130, 137, 140, 143, 175] ? 'retry' : 'terminate' }
    maxRetries = 2
    maxErrors = '-1'

    // Defaults for processes whose labels set only some resources (e.g. GTDB-Tk's
    // process_high_memory): SLURM rejects jobs submitted without a time limit.
    cpus = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time = { 4.h * task.attempt }

    resourceLimits = [
        cpus: params.max_cpus,
        memory: params.max_memory,
        time: params.max_time
    ]

    withLabel: 'process_single' {
        cpus = { 1 * task.attempt }
        memory = { 6.GB * task.attempt }
        time = { 4.h * task.attempt }
    }

    withLabel: 'process_low' {
        cpus = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time = { 4.h * task.attempt }
    }

    withLabel: 'process_medium' {
        cpus = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time = { 8.h * task.attempt }
    }

    withLabel: 'process_high' {
        cpus = { 12 * task.attempt }
        memory = { 72.GB * task.attempt }
        time = { 16.h * task.attempt }
    }

    withLabel: 'process_long' {
        time = { 20.h * task.attempt }
    }

    // One assembler crashing on one subset is expected: 27 of 28 input assemblies still
    // make a consensus. Retryable exit codes are retried first, then the assembly is given
    // up on and recorded in assembly_attempts.tsv. These processes also run on node-local
    // scratch, which conf/slurm.config sets: it is an HPC filesystem concern, and it
    // breaks a local container run, where /tmp inside the image is not writable.
    withLabel: 'assembler' {
        errorStrategy = { task.exitStatus in [104, 125, 130, 137, 140, 143, 175] && task.attempt <= 2 ? 'retry' : 'ignore' }
    }

    withLabel: 'process_high_memory' {
        memory = { 200.GB * task.attempt }
    }
}
