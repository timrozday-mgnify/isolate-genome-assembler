executor {
    name = 'slurm'
    queueSize = params.slurm_queue_size
    submitRateLimit = '10/1min'
    pollInterval = '30 sec'
}

process {
    clusterOptions = { params.slurm_cluster_options ?: null }

    // The assemblers write many small intermediate files. On a cluster those belong on
    // node-local disk, not on the shared filesystem everyone else is using.
    withLabel: 'assembler' {
        scratch = true
    }
}
