// Shared settings for the `test` and `test_stub` profiles. The database paths are empty
// sentinel files: stubs never read them, and they keep the start-up checks honest.
params {
    // Small enough to run on a laptop or a CI runner.
    max_cpus = 2
    max_memory = '4.GB'
    max_time = '1.h'

    input = "${projectDir}/tests/data/empty_samplesheet.yml"
    outdir = "${projectDir}/results_test"

    sylph_gtdb_db = "${projectDir}/tests/data/databases/gtdb.syldb"
    sylph_gtdb_taxonomy = "${projectDir}/tests/data/databases/gtdb_metadata.tsv.gz"
    sylph_human_db = "${projectDir}/tests/data/databases/human.syldb"
    human_reference = "${projectDir}/tests/data/databases/chm13.fa.gz"
    plassembler_db = "${projectDir}/tests/data/databases/plassembler_db"
    checkm2_db = "${projectDir}/tests/data/databases/checkm2.dmnd"
    bakta_db = "${projectDir}/tests/data/databases/bakta_db"
    busco_db = "${projectDir}/tests/data/databases/busco_downloads"
    gtdbtk_db = "${projectDir}/tests/data/databases/gtdbtk_db"
    ideel_db = "${projectDir}/tests/data/databases/ideel.dmnd"
}

// conf/base.config reads params.max_* when it is included, which is before a profile can
// change them, so the test limits are set on the process scope directly.
process {
    resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
}
