// Config for dev/benchmark.nf. Launch the benchmark from outside the repo, so the
// pipeline's own nextflow.config is not picked up from the launch directory as well.
params {
    // simulate: truth genomes and reads. consensus: rerun Autocycler for each arm.
    mode = 'simulate'
    genomes = "${projectDir}/benchmark_genomes.tsv"
    arms = "${projectDir}/benchmark_arms.tsv"
    // Read depths for the simulated genomes; the real runs are used at their own depth.
    depths = '30,60,120'
    // PBSIM3 settings: 10 passes gives rq ~0.997 after ccs, and 11 +/- 3 kb inserts are a
    // typical size-selected HiFi library.
    sim_passes = 10
    sim_length_mean = 11000
    sim_length_sd = 3000
    // Where samples.yml, reads/, truth/ and consensus/ go.
    outdir = './benchmark'
    // The pipeline's --outdir from step 2, read by --mode consensus.
    results = './results'
    publish_dir_mode = 'copy'

    // Read by conf/base.config and conf/slurm.config, as in the pipeline.
    max_cpus = 16
    max_memory = '128 GB'
    max_time = '240 h'
    slurm_queue_size = 50
    slurm_cluster_options = ''
    singularity_cache_dir = "${projectDir}/../work/singularity"
    // Read by the AUTOCYCLER_CONSENSUS stub.
    stub_fully_resolved = true
}

includeConfig '../conf/base.config'

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: params.singularity_cache_dir
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: params.singularity_cache_dir
    }
    slurm {
        includeConfig '../conf/slurm.config'
    }
}

process {
    withName: 'TRUTH' {
        publishDir = [path: { "${params.outdir}/truth" }, mode: params.publish_dir_mode]
    }
    // ccs is CPU-bound; process_high's memory would only make it harder to schedule.
    withName: 'CCS' {
        memory = { 16.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: 'CCS|FETCH_READS' {
        publishDir = [path: { "${params.outdir}/reads" }, mode: params.publish_dir_mode]
    }
    withName: 'AUTOCYCLER_CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/consensus/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.{consensus.fasta,consensus.yaml,autocycler_table.tsv}',
        ]
    }
}

// assembler_benchmark.py reads the consensus trace for each arm's consensus cost.
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace_${params.mode}.txt"
    overwrite = true
    fields = 'task_id,hash,name,process,tag,status,exit,realtime,%cpu,peak_rss,cpus,memory'
}
