params {
    // Path to the YAML samplesheet. Required for work; omitted for a syntax-only preview.
    input = null
    // Directory for opt-in published outputs and Nextflow provenance reports.
    outdir = './results'
    // Enable process output publication; disabled by default to avoid unrequested copies.
    publish_outputs = false
    // Publish the 28 per-subset input assemblies too. Off by default: they are bulky and
    // only useful when inspecting a consensus that went wrong.
    publish_input_assemblies = false
    // Publish mode used only when --publish_outputs is enabled.
    publish_dir_mode = 'copy'
    // Upper CPU bound for any task, protecting shared HPC resources.
    max_cpus = 16
    // Upper memory bound for any task, protecting shared HPC resources.
    max_memory = '128 GB'
    // Upper wall-time bound for any task, protecting shared HPC resources.
    max_time = '240 h'
    // Maximum number of queued SLURM jobs, limiting scheduler pressure from assembler fan-out.
    slurm_queue_size = 50
    // Site-specific SLURM options such as account, partition, or QoS; empty by default.
    slurm_cluster_options = ''
    // Fallback container cache when NXF_SINGULARITY_CACHEDIR is not set by the site.
    singularity_cache_dir = "${projectDir}/work/singularity"

    // --- Read QC (stage 1) ---
    // Minimum mean read accuracy. A hifi_reads file is Q20+ by definition, so reads below
    // this are a sign the wrong file was supplied; they are dropped and counted.
    min_read_qv = 20
    // Drop reads with leftover PacBio adapter/primer hits. They are few and they confuse
    // assemblers, so removal is on by default; the counts are reported either way.
    remove_adapter_reads = true
    // K-mer length for the KMC + GenomeScope2 genome size estimate. 21 is GenomeScope's
    // own default and is long enough to be near-unique in a bacterial genome.
    kmer_size = 21

    // --- Contamination screen (stage 2) ---
    // Human read fraction at which `--remove_human auto` removes human reads. The same
    // value is the warn threshold in assets/qc_thresholds.yml.
    contam_max_human = 0.001
    // auto: remove human reads only when human is detected. true: always. false: never.
    remove_human = 'auto'

    // --- Subsample and assemble (stage 3) ---
    // Assemblers run on each subsampled read set, as a comma-separated list. The seven
    // defaults are algorithmically distinct, which is what makes a consensus worth taking;
    // `myloasm` and `lja` are also supported. Defaults are revisited in Phase 6.
    assemblers = 'flye,hifiasm,raven,canu,miniasm,metamdbg,plassembler'
    // Number of independent subsampled read sets. 4 subsets x 7 assemblers is the 28-input
    // scale Autocycler's clustering thresholds assume.
    subsample_count = 4
    // Minimum depth a subset may have. Below Autocycler's own default of 25 the individual
    // assemblies are too poor to vote usefully.
    subsample_min_depth = 25
    // Test-only: the value the AUTOCYCLER_CONSENSUS stub reports for
    // consensus_assembly_fully_resolved, so the Flye fallback path can be exercised.
    stub_fully_resolved = true
    // Test-only: comma-separated <assembler>_<subset> ids whose stub exits 1, so the
    // tolerance of a failed assembler can be exercised.
    stub_fail_assemblies = ''

    // --- Finishing (stage 5) ---
    // Contigs shorter than this are flagged. 1 kb is below any real replicon and above
    // the assembly fragments that clutter a consensus.
    min_contig_len = 1000
    // A contig at least this long is called a chromosome even when it is not the longest,
    // which is what a genuinely multi-chromosome genome needs.
    chromosome_min_len = 1000000
    // Non-chromosomal contigs below this fraction of chromosome depth are flagged: at
    // isolate depth they are more likely a contaminant or a sub-population than a replicon.
    min_contig_depth_ratio = 0.1
    // Flagged contigs are kept in the final assembly by default and only reported. Setting
    // this moves them to <id>.removed_contigs.fasta instead.
    drop_flagged_contigs = false
    // Bases from each contig end compared for leftover circular duplication. 10 kb is well
    // above the overlap an assembler leaves and cheap to align.
    contig_end_window = 10000
    // skani thresholds for calling a Plassembler plasmid recovered in the final assembly.
    // 95% ANI over 90% of the plasmid is the same species and essentially the whole thing.
    plasmid_audit_min_identity = 95
    plasmid_audit_min_coverage = 90

    // --- Checks (stage 6) ---
    // mosdepth windows below/above these multiples of their contig's median depth are
    // flagged: a drop suggests a misassembly, ~2x a collapsed repeat.
    coverage_low_ratio = 0.5
    coverage_high_ratio = 2.0
    // A clipping pile-up needs at least this many reads, making up this fraction of the
    // depth, clipped by at least this many bases at one place. One or two clipped reads
    // are noise; a fifth of the depth is a candidate misjoin.
    clip_min_reads = 5
    clip_min_fraction = 0.2
    clip_min_length = 500
    // Sites with fewer reads than this are not binned by allele frequency: at low depth
    // one read moves the frequency across a bin edge.
    variant_min_depth = 10
    // Indels in homopolymers at least this long are tallied separately: they are HiFi's
    // known systematic error, not necessarily the assembly's.
    homopolymer_min_len = 8
    // A protein shorter than this fraction of its best Swiss-Prot hit counts as truncated
    // in the IDEEL test; 0.9 is the cut-off the IDEEL method uses.
    ideel_min_ratio = 0.9
    // BUSCO lineage, looked up offline in --busco_db.
    busco_lineage = 'bacteria_odb12'

    // --- QC gates (stage 7) ---
    // Pass/warn/fail thresholds for every check. Replace the file to change them; see its
    // header for the format. The defaults are recalibrated in Phase 6.
    qc_thresholds = "${projectDir}/assets/qc_thresholds.yml"

    // --- Databases (built by --prepare_databases, then passed in) ---
    // Prebuilt sylph GTDB r226 database; r226 is pinned to match GTDB-Tk in later stages.
    sylph_gtdb_db = null
    // sylph-tax metadata matching the GTDB database above.
    sylph_gtdb_taxonomy = null
    // sylph sketch of CHM13 v2.0 + GRCh38, queried rather than profiled for sensitivity.
    sylph_human_db = null
    // CHM13 v2.0 FASTA, used for the mapped human read fraction.
    human_reference = null
    // Plassembler's database (PLSDB plus its mash sketches), built by `plassembler download`.
    plassembler_db = null
    // CheckM2's DIAMOND database (uniref100.KO.1.dmnd).
    checkm2_db = null
    // Bakta database; the light build by default (decided 2026-09-17).
    bakta_db = null
    // BUSCO download directory holding --busco_lineage, for offline runs.
    busco_db = null
    // GTDB-Tk reference data for r226, pinned to match the sylph database.
    gtdbtk_db = null
    // DIAMOND database of UniProt Swiss-Prot, the reference proteins for the IDEEL test.
    ideel_db = null

    // --- Database sources, used only when --prepare_databases is set ---
    // Download and build the databases instead of running the pipeline. Nextflow's strict
    // syntax no longer supports `-entry`, so this stage is selected with a param.
    prepare_databases = false
    sylph_gtdb_db_url = 'http://faust.compbio.cs.cmu.edu/sylph-stuff/gtdb-r226-c200-dbv1.syldb'
    sylph_gtdb_taxonomy_url = 'https://raw.githubusercontent.com/bluenote-1577/sylph-tax/main/taxonomy_files/gtdb_r226_metadata.tsv.gz'
    chm13_url = 'https://s3-us-west-2.amazonaws.com/human-pangenomics/T2T/CHM13/assemblies/analysis_set/chm13v2.0.fa.gz'
    grch38_url = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz'
    checkm2_db_url = 'https://zenodo.org/records/14897628/files/checkm2_database.tar.gz'
    gtdbtk_db_url = 'https://data.gtdb.aau.ecogenomic.org/releases/release226/226.0/auxillary_files/gtdbtk_package/full_package/gtdbtk_r226_data.tar.gz'
    ideel_db_url = 'https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/complete/uniprot_sprot.fasta.gz'
    // Where --prepare_databases writes the databases it builds.
    database_dir = "${params.outdir}/databases"
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled = true
        singularity.enabled = false
        apptainer.enabled = false
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        docker.enabled = false
        singularity.enabled = true
        apptainer.enabled = false
        singularity.autoMounts = true
        singularity.cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: params.singularity_cache_dir
    }

    apptainer {
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: params.singularity_cache_dir
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    test {
        includeConfig 'conf/test.config'
    }

    test_stub {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    // `name` is process plus tag, which is what identifies a task in a fan-out of 28
    // assemblies; nf-test's trace parser needs the column too.
    fields = 'task_id,hash,native_id,name,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,cpus,memory,time,workdir'
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

manifest {
    name = 'timrozday/isolate-genome-assembler'
    author = 'Tim Rozday'
    homePage = 'https://github.com/timrozday/isolate-genome-assembler'
    description = 'Complete, checked bacterial and archaeal isolate genomes from PacBio HiFi reads.'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.0.0'
    version = '0.0.0-dev'
}
